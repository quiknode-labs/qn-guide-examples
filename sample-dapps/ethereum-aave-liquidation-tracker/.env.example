# Browser: project URL and publishable key, available in Supabase Project Settings > API Keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backend only. Never prefix this secret with VITE_ or expose it in the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

PORT=3005
# Full Ethereum mainnet endpoint: https://your-endpoint.ethereum-mainnet.quiknode.pro/your-token/
QUICKNODE_RPC_URL=YOUR_ETHEREUM_MAINNET_RPC_ENDPOINT
# Streams > Your paused Stream > Destination > Security token. Required.
WEBHOOK_SECRET_KEY=YOUR_STREAM_SECURITY_TOKEN
