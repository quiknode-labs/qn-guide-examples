{
  "name": "tokens-metis-bot",
  "version": "0.1.0",
  "description": "Rules-based Solana trading bot sample using the Tokens API for discovery and Quicknode Metis (Jupiter Swap) for execution. Educational, not financial advice.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx --env-file=env.local src/index.ts",
    "start:once": "RUN_ONCE=true tsx --env-file=env.local src/index.ts",
    "dev": "tsx watch --env-file=env.local src/index.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@solana/kit": "^7.0.0",
    "@solana/kit-plugin-signer": "^0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
