{
    "mcpServers": {
        "solana": {
            "command": "node",
            "args": [
                "/absolute/path/to/build/index.js"
            ],
            "env": {
                "SOLANA_RPC_ENDPOINT": "https://your-endpoint.solana-mainnet.quiknode.pro/",
                "SOLANA_RPC_TOKEN": "your-auth-token"
            }
        }
    }
}


