# Robinhood Chain (chainId 4663) endpoints from your Quicknode dashboard.
# Copy this file to .env. The endpoint carries a token, so never commit the filled-in file.
# The snippets read these from the environment; export them, or: set -a; source .env; set +a
QUICKNODE_RPC=https://<your-endpoint>.quiknode.pro/<token>/
QUICKNODE_WS=wss://<your-endpoint>.quiknode.pro/<token>/
