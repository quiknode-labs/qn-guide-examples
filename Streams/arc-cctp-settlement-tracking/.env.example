# Initial database owner connection, used by npm run setup once.
# Setup replaces PGUSER and PGPASSWORD with the restricted application login.
PGHOST='<POSTGRES_HOST>'
PGPORT=5432
PGDATABASE=postgres
PGUSER='<DATABASE_OWNER_USERNAME>'
PGPASSWORD='<DATABASE_OWNER_PASSWORD>'
PGSSLMODE=verify-full
# If required by the provider, set the path to its public root CA certificate.
# PGSSLROOTCERT='/absolute/path/to/provider-ca.crt'
RECONCILE_LIMIT=100
